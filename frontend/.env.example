# The URL of the Next.js API proxy route from the browser's perspective.
# Leave unset to call the same-origin /api/trip proxy.
# NEXT_PUBLIC_API_URL=http://localhost:3000/api/trip

# Server-side: where the Next.js proxy forwards /api/trip requests to.
# This must point at the running Python FastAPI backend.
AI_BACKEND_URL=http://localhost:8000

# Python backend conversion rate (INR per USD) used for prototype estimates.
INR_PER_USD=83.0