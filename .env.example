# AI Trip Planner - backend configuration.
# Copy to .env and adjust. Never commit .env (it is gitignored).
# Frontend-only variables live in frontend/.env.example.

# Python backend conversion rate (INR per USD) used for prototype estimates.
INR_PER_USD=83.0

# Weather provider (Open-Meteo, no API key required). Override to swap provider.
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=8.0

# Places provider (Overpass / OpenStreetMap, no API key required).
PLACES_API_URL=https://overpass-api.de/api/interpreter
PLACES_TIMEOUT_SECONDS=12.0
# Reserved for a future commercial places provider (not required):
# PLACES_API_KEY=

# Routing provider (public OSRM demo server, no API key required).
ROUTES_API_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=8.0
# Reserved for a future commercial routes provider (not required):
# ROUTES_API_KEY=

# Reserved for optional LLM summaries of the final plan (not required):
# LLM_API_KEY=

# Validation / re-planning engine: max re-plan attempts before giving up.
MAX_REPLAN_ATTEMPTS=3
