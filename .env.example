# Backend reads .env from the repository root. Never commit credentials.
TRIP_DB_PATH=data/trips.sqlite3

# Connect only to an already running local OpenAI-compatible model server.
# No model installation, download, or load requests are made by this application.
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=

# Optional live hotel offers: Amadeus production credentials, never test data.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Optional walking/driving routes and traffic-aware driving times.
TOMTOM_API_KEY=

# Configurable public Overpass endpoint. Respect the provider's usage policy.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional traveler-configured conversion; blank means conversion is unavailable.
INR_PER_USD=

# Checks run while the backend is running, for trips within the forecast window.
MONITOR_INTERVAL_SECONDS=900
MAX_REPLAN_ATTEMPTS=3
